<Document>
 <name>Wielki Luk Kolejowy: Bangkok - Ha Long</name>
 <description>Trasa Bangkok - Laos - Junnan - Zatoka Ha Long. Punkty = centra miast/dworce (przyblizone). Linie = przebieg pogladowy, nie dokladny slad torow.</description>

 <Style id="sleeper"><LineStyle><color>ff8b3d8b</color><width>4</width></LineStyle></Style>
 <Style id="hsr"><LineStyle><color>ffd07830</color><width>4</width></LineStyle></Style>
 <Style id="walk"><LineStyle><color>ff2222cc</color><width>4</width></LineStyle></Style>
 <Style id="bus"><LineStyle><color>ff338833</color><width>4</width></LineStyle></Style>
 <Style id="flight"><LineStyle><color>ff999999</color><width>3</width></LineStyle></Style>
 <Style id="stop"><IconStyle><scale>1.1</scale><Icon><href>http://maps.google.com/mapfiles/kml/paddle/red-circle.png</href></Icon></IconStyle></Style>

 <Folder>
 <name>Przystanki</name>
 <Placemark><styleUrl>#stop</styleUrl><name>1. Bangkok (Krung Thep Aphiwat)</name><description>Start. Sleeper nr 133 do Wientianu, ~11 h</description><Point><coordinates>100.5389,13.8039,0</coordinates></Point></Placemark>
 <Placemark><styleUrl>#stop</styleUrl><name>Nong Khai (granica TH/LA)</name><description>Odprawa wyjazdowa z Tajlandii, Most Przyjazni nad Mekongiem</description><Point><coordinates>102.7449,17.8783,0</coordinates></Point></Placemark>
 <Placemark><styleUrl>#stop</styleUrl><name>2. Wientian</name><description>1 dzien: Pha That Luang, Patuxai. Uwaga: 2 rozne dworce (Khamsavath vs dworzec LCR)</description><Point><coordinates>102.6331,17.9757,0</coordinates></Point></Placemark>
 <Placemark><styleUrl>#stop</styleUrl><name>3. Vang Vieng</name><description>1-2 noce: krasowe ostance, Nam Song, laguny</description><Point><coordinates>102.4478,18.9231,0</coordinates></Point></Placemark>
 <Placemark><styleUrl>#stop</styleUrl><name>4. Luang Prabang</name><description>2-3 noce, UNESCO. Dworzec ~12 km od miasta</description><Point><coordinates>102.1350,19.8867,0</coordinates></Point></Placemark>
 <Placemark><styleUrl>#stop</styleUrl><name>Boten / Mohan (granica LA/CN)</name><description>Odprawa ~90 min, pociag D888 czeka</description><Point><coordinates>101.6800,21.1850,0</coordinates></Point></Placemark>
 <Placemark><styleUrl>#stop</styleUrl><name>5-6. Kunming</name><description>1-2 dni: Kamienny Las (Shilin), jezioro Dian. Przyjazd: Kunming South; wyjazd do Hekou: Kunming Main!</description><Point><coordinates>102.7060,25.0430,0</coordinates></Point></Placemark>
 <Placemark><styleUrl>#stop</styleUrl><name>7. Hekou North (koniec chinskich torow)</name><description>Bus 2 RMB do portu granicznego</description><Point><coordinates>103.9390,22.5290,0</coordinates></Point></Placemark>
 <Placemark><styleUrl>#stop</styleUrl><name>8. Lao Cai (granica CN/VN, pieszo przez most)</name><description>Przejscie piesze ~1-1.5 h. Opcja: Sapa. Wieczorem sleeper do Hanoi</description><Point><coordinates>103.9707,22.4856,0</coordinates></Point></Placemark>
 <Placemark><styleUrl>#stop</styleUrl><name>9. Hanoi</name><description>1-2 dni: Stare Miasto, Train Street, most Long Bien</description><Point><coordinates>105.8542,21.0285,0</coordinates></Point></Placemark>
 <Placemark><styleUrl>#stop</styleUrl><name>10. Zatoka Ha Long</name><description>Rejs 2 dni / 1 noc, UNESCO. Wariant: Lan Ha / Bai Tu Long</description><Point><coordinates>107.1839,20.9101,0</coordinates></Point></Placemark>
 <Placemark><styleUrl>#stop</styleUrl><name>11. Hanoi Noi Bai (HAN) - lot powrotny</name><description>HAN - BKK ~2 h</description><Point><coordinates>105.8072,21.2212,0</coordinates></Point></Placemark>
 </Folder>

